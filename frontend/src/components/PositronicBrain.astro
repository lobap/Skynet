<div id="brain-container" class="w-full h-full absolute inset-0 -z-10 pointer-events-none"></div>

<script>
    import * as THREE from 'three';

    class ThoughtNode {
        constructor(scene, type, text, origin) {
            this.scene = scene;
            this.life = 0;
            this.maxLife = 6.0; 
            this.active = true;

            const resolutionScale = 2.0;
            this.text = text;
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            
            // LARGER FONT
            const fontSize = 9 * resolutionScale;
            context.font = `400 ${fontSize}px "Segoe UI", Roboto, Arial, sans-serif`;
            
            // MULTILINE: Wrap text
            const maxWidth = 400 * resolutionScale;
            const words = text.split(' ');
            const lines = [];
            let currentLine = '';
            
            for (const word of words) {
                const testLine = currentLine ? currentLine + ' ' + word : word;
                const testWidth = context.measureText(testLine).width;
                if (testWidth > maxWidth && currentLine) {
                    lines.push(currentLine);
                    currentLine = word;
                } else {
                    currentLine = testLine;
                }
            }
            if (currentLine) lines.push(currentLine);
            
            // Calculate dimensions
            const lineHeight = fontSize * 1.3;
            const paddingX = 30 * resolutionScale;
            const paddingY = 20 * resolutionScale;
            
            let maxLineWidth = 0;
            for (const line of lines) {
                const w = context.measureText(line).width;
                if (w > maxLineWidth) maxLineWidth = w;
            }
            
            const width = maxLineWidth + (paddingX * 2);
            const height = (lines.length * lineHeight) + (paddingY * 2);
            
            canvas.width = width;
            canvas.height = height;
            
            // Re-set font after resize
            context.font = `400 ${fontSize}px "Segoe UI", Roboto, Arial, sans-serif`;
            
            // SIMPLE GRAY BACKGROUND (matching cube style)
            const cornerRadius = 8 * resolutionScale;
            context.beginPath();
            context.roundRect(0, 0, width, height, cornerRadius);
            context.fillStyle = 'rgba(40, 40, 50, 0.8)';
            context.fill();
            
            // Subtle gray border
            context.strokeStyle = 'rgba(100, 100, 110, 0.5)';
            context.lineWidth = 1 * resolutionScale;
            context.stroke();
            // Draw multiline text (white)
            context.fillStyle = '#ffffff';
            context.textAlign = 'center';
            context.textBaseline = 'middle';
            
            const startY = paddingY + (lineHeight / 2);
            for (let i = 0; i < lines.length; i++) {
                context.fillText(lines[i], width / 2, startY + (i * lineHeight));
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.minFilter = THREE.LinearFilter;
            
            const material = new THREE.SpriteMaterial({ 
                map: texture, 
                transparent: true, 
                opacity: 0,
                depthTest: false, // Multiply visibility
                depthWrite: false
            });
            
            this.sprite = new THREE.Sprite(material);
            this.sprite.renderOrder = 999; 
            
            // Scale: Normal, readable size. Not huge.
            // 0.005 was V4 (good). 0.012 was V7 (too big?).
            // Let's try 0.008 - Balanced
            const worldScaleFactor = 0.016 / resolutionScale; 
            this.sprite.scale.set(width * worldScaleFactor, height * worldScaleFactor, 1);
            
            // Position
            const radius = 6.5; 
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1) * 0.6; // Mostly top
            
            this.targetPos = new THREE.Vector3(
                radius * Math.sin(phi) * Math.cos(theta),
                radius * Math.sin(phi) * Math.sin(theta),
                radius * Math.cos(phi) + 1.0 
            );
            
            this.sprite.position.copy(origin); 

            // Connection Line: Simple
            const geometry = new THREE.BufferGeometry().setFromPoints([origin, this.sprite.position]);
            const lineMat = new THREE.LineBasicMaterial({ 
                color: accentColor, 
                transparent: true, 
                opacity: 0.3,
                depthTest: true
            });
            
            this.line = new THREE.Line(geometry, lineMat);

            scene.add(this.sprite);
            scene.add(this.line);
        }

        update(dt) {
            this.life += dt;
            const progress = this.life / this.maxLife;

            if (progress >= 1) {
                this.active = false;
                return;
            }

            // Standard lerp
            if (this.life < 1.0) {
                 this.sprite.position.lerp(this.targetPos, 0.1);
            } 

            // Opacity
            let opacity = 1;
            if (progress < 0.2) opacity = progress * 5; 
            else if (progress > 0.8) opacity = (1 - progress) * 5; 
            
            this.sprite.material.opacity = opacity;
            this.line.material.opacity = opacity * 0.3;

            const positions = this.line.geometry.attributes.position.array;
            positions[3] = this.sprite.position.x;
            positions[4] = this.sprite.position.y;
            positions[5] = this.sprite.position.z;
            this.line.geometry.attributes.position.needsUpdate = true;
        }

        dispose() {
             this.scene.remove(this.sprite);
             this.scene.remove(this.line);
             this.sprite.material.dispose();
             this.sprite.geometry.dispose();
             this.line.material.dispose();
             this.line.geometry.dispose();
        }
    }

    class PositronicBrain {
        constructor(container) {
            this.container = container;
            this.scene = new THREE.Scene();
            this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            this.renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            
            this.particles = null;
            this.count = 5000; 
            this.positions = new Float32Array(this.count * 3);
            this.colors = new Float32Array(this.count * 3);
            this.originalColors = new Float32Array(this.count * 3);
            this.sizes = new Float32Array(this.count);
            this.initialPositions = new Float32Array(this.count * 3); 
            
            this.signals = []; 
            this.thoughtNodes = []; 
            this.synapses = []; 
            
            this.mouseX = 0;
            this.mouseY = 0;
            this.targetRotationX = 0;
            this.targetRotationY = 0;
            this.currentRotationX = 0;
            this.currentRotationY = 0;

            this.init();
            this.animate();
        }

        init() {
            this.renderer.setSize(this.container.clientWidth, this.container.clientHeight);
            this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            this.container.appendChild(this.renderer.domElement);

            // --- 1. CUBE WITH SUBTLE WALLS ---
            const cubeSize = 5.5; 
            const cubeGeometry = new THREE.BoxGeometry(cubeSize, cubeSize, cubeSize);
            
            // Translucent walls (10% opacity)
            const wallMaterial = new THREE.MeshBasicMaterial({ 
                color: 0x334455,
                transparent: true, 
                opacity: 0.1,
                side: THREE.DoubleSide,
                depthWrite: false
            });
            this.cubeMesh = new THREE.Mesh(cubeGeometry, wallMaterial);
            
            // Soft gray wireframe edges (using same geometry)
            const edges = new THREE.EdgesGeometry(cubeGeometry);
            const wireMaterial = new THREE.LineBasicMaterial({ 
                color: 0x888888,
                transparent: true, 
                opacity: 0.5
            });
            this.wireframeMesh = new THREE.LineSegments(edges, wireMaterial);
            
            // headMesh groups everything (cube + edges)
            this.headMesh = new THREE.Object3D();
            this.headMesh.add(this.cubeMesh);
            this.headMesh.add(this.wireframeMesh);
            this.scene.add(this.headMesh);

            // --- 2. INTERNAL SWARM (Enhanced Visibility) ---
            const geometry = new THREE.BufferGeometry();
            const color = new THREE.Color(0x60a5fa); 

            for(let i = 0; i < this.count; i++) {
                const limit = (cubeSize / 2) - 0.1;
                const x = (Math.random() - 0.5) * 2 * limit;
                const y = (Math.random() - 0.5) * 2 * limit;
                const z = (Math.random() - 0.5) * 2 * limit;

                this.positions[i * 3] = x;
                this.positions[i * 3 + 1] = y;
                this.positions[i * 3 + 2] = z;

                this.initialPositions[i * 3] = x;
                this.initialPositions[i * 3 + 1] = y;
                this.initialPositions[i * 3 + 2] = z;

                this.colors[i * 3] = color.r;
                this.colors[i * 3 + 1] = color.g;
                this.colors[i * 3 + 2] = color.b;
                this.originalColors[i * 3] = color.r;
                this.originalColors[i * 3 + 1] = color.g;
                this.originalColors[i * 3 + 2] = color.b;

                // VISIBILITY FIX: Larger Minimum Size
                // Previously 0.06 - 0.25
                this.sizes[i] = 0.25 + (Math.random() * 0.25); 
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(this.positions, 3));
            geometry.setAttribute('color', new THREE.BufferAttribute(this.colors, 3));
            geometry.setAttribute('size', new THREE.BufferAttribute(this.sizes, 1));

            const material = new THREE.PointsMaterial({
                size: 0.1,
                vertexColors: true,
                blending: THREE.AdditiveBlending,
                transparent: true,
                opacity: 1.0,
                sizeAttenuation: true,
                depthWrite: false 
            });

            this.particles = new THREE.Points(geometry, material);
            this.scene.add(this.particles);

            // --- 3. PLATFORM ---
            const planeGeometry = new THREE.PlaneGeometry(30, 30);
            const planeMaterial = new THREE.MeshStandardMaterial({
                color: 0x020617,
                metalness: 0.9,
                roughness: 0.2,
            });
            const plane = new THREE.Mesh(planeGeometry, planeMaterial);
            plane.rotation.x = -Math.PI / 2;
            plane.position.y = - (cubeSize / 2) - 2.0; 
            this.scene.add(plane);

            // --- 4. LIGHTING ---
            // Increased lighting for visibility
            this.scene.add(new THREE.AmbientLight(0xffffff, 0.8));
            
            const innerLight = new THREE.PointLight(0x60a5fa, 5, 20);
            innerLight.position.set(0, 0, 0);
            this.scene.add(innerLight);

            const spotLight = new THREE.SpotLight(0xffffff, 80);
            spotLight.position.set(10, 15, 10);
            spotLight.angle = Math.PI / 6;
            this.scene.add(spotLight);
            
            const rimLight = new THREE.PointLight(0xf472b6, 3, 20); 
            rimLight.position.set(-8, 5, -8);
            this.scene.add(rimLight);

            this.camera.position.set(0, 0, 13); 
            this.camera.lookAt(0, 0, 0);

            if (typeof window !== 'undefined') {
                window.addEventListener('resize', () => this.onWindowResize());
                document.addEventListener('mousemove', (event) => {
                    this.mouseX = (event.clientX - window.innerWidth / 2) * 0.0003; 
                    this.mouseY = (event.clientY - window.innerHeight / 2) * 0.0003;
                });
            }
        }
        
        onWindowResize() {
            if (!this.container) return;
            this.camera.aspect = this.container.clientWidth / this.container.clientHeight;
            this.camera.updateProjectionMatrix();
            this.renderer.setSize(this.container.clientWidth, this.container.clientHeight);
        }

        fireSignal(thoughtText = "") {
            const text = thoughtText.toLowerCase();
            let type = 'default';
            let targetColor = new THREE.Color(0xffffff);

            if (text.includes("error") || text.includes("fail")) {
                type = 'error';
                targetColor.setHex(0xf87171);
            } else if (text.includes("plan") || text.includes("think")) {
                type = 'plan';
                targetColor.setHex(0xd946ef);
            } else if (text.includes("code") || text.includes("function")) {
                type = 'code';
                targetColor.setHex(0x34d399);
            } else if (text.includes("tool") || text.includes("command")) {
                type = 'tool';
                targetColor.setHex(0xfbbf24);
            } else {
                 targetColor.setHex(0x60a5fa);
            }

            this.signals.push({
                type: 'shockwave',
                strength: 3.0, 
                color: targetColor
            });

            if (thoughtText.length > 2) {
                // Shorten text for clean popups
                let label = thoughtText.substring(0, 48); 
                if (thoughtText.length > 48) label += "...";
                
                // Keep descriptive but simple
                if (type === 'tool') label = "Running Tool: " + label.substring(0, 30);
                if (type === 'code') label = "Coding: " + label.substring(0, 30);
                
                const node = new ThoughtNode(this.scene, type, label, new THREE.Vector3(0,0,0));
                this.thoughtNodes.push(node);
            }
        }

        animate() {
            requestAnimationFrame(() => this.animate());

            const time = Date.now() * 0.001;
            
            this.targetRotationX = THREE.MathUtils.lerp(this.targetRotationX, this.mouseY * 2.0, 0.02); 
            this.targetRotationY = THREE.MathUtils.lerp(this.targetRotationY, this.mouseX * 2.0, 0.02); 
            this.currentRotationX = THREE.MathUtils.clamp(this.targetRotationX, -0.4, 0.4);
            this.currentRotationY = THREE.MathUtils.clamp(this.targetRotationY, -0.6, 0.6);

            if (this.headMesh) {
                this.headMesh.rotation.x = this.currentRotationX + Math.sin(time * 0.2) * 0.05; 
                this.headMesh.rotation.y = this.currentRotationY + Math.sin(time * 0.1) * 0.05; 
                
                if (this.wireframeMesh) this.wireframeMesh.rotation.copy(this.headMesh.rotation);
                if (this.particles) this.particles.rotation.copy(this.headMesh.rotation);
            }

            const positions = this.particles.geometry.attributes.position.array;
            const colorAttribute = this.particles.geometry.attributes.color;
            const sizeAttribute = this.particles.geometry.attributes.size;

            if (this.signals.length > 0) {
                 for (let i = this.signals.length - 1; i >= 0; i--) {
                    const signal = this.signals[i];
                    signal.strength -= 0.04; 
                    if (signal.strength <= 0) this.signals.splice(i, 1);
                 }
            }
            
            let globalPulse = 0;
            let pulseColor = null;
            if (this.signals.length > 0) {
                globalPulse = this.signals[0].strength;
                pulseColor = this.signals[0].color;
            }

            // Synaptic Idling: 
            // V8: Increased idle frequency 
            if (Math.random() < 0.15) { 
                this.synapses.push({ 
                    index: Math.floor(Math.random() * this.count), 
                    life: 1.0 
                });
            }

            for(let i = 0; i < this.count; i++) {
                const ix = i * 3;
                const ox = this.initialPositions[ix];
                const oy = this.initialPositions[ix + 1];
                const oz = this.initialPositions[ix + 2];
                
                // ORGANIC BLOB ANIMATION
                // Each particle has unique phase based on position
                const particlePhase = (ox + oy + oz) * 0.5;
                
                // Multi-frequency breathing (organic feel)
                const breathFast = Math.sin(time * 2.0 + particlePhase) * 0.15;
                const breathSlow = Math.sin(time * 0.5 + particlePhase * 0.3) * 0.3;
                const breathMicro = Math.sin(time * 4.0 + i * 0.01) * 0.05;
                
                // Direction based on position (expands/contracts radially)
                const distFromCenter = Math.sqrt(ox*ox + oy*oy + oz*oz);
                const normalX = distFromCenter > 0.1 ? ox / distFromCenter : 0;
                const normalY = distFromCenter > 0.1 ? oy / distFromCenter : 0;
                const normalZ = distFromCenter > 0.1 ? oz / distFromCenter : 0;
                
                // Combine breathing + drift
                const totalBreath = breathFast + breathSlow + breathMicro + (globalPulse * 0.5);
                
                positions[ix] = ox + normalX * totalBreath + Math.sin(time + oy) * 0.08;
                positions[ix+1] = oy + normalY * totalBreath + Math.cos(time * 0.8 + ox) * 0.08;
                positions[ix+2] = oz + normalZ * totalBreath + Math.sin(time * 0.5 + oz) * 0.08;

                let r = this.originalColors[ix];
                let g = this.originalColors[ix+1];
                let b = this.originalColors[ix+2];
                
                // DYNAMIC SIZE (Pulsing individually)
                const baseSizeForParticle = 0.2 + Math.abs(Math.sin(time * 1.5 + particlePhase)) * 0.15;
                let size = baseSizeForParticle;

                if (globalPulse > 0.1 && pulseColor) {
                    if (Math.random() < globalPulse * 0.3) {
                        r = pulseColor.r;
                        g = pulseColor.g;
                        b = pulseColor.b;
                        size = 0.4 + (globalPulse * 0.2);
                    }
                }
                
                colorAttribute.setXYZ(i, r, g, b);
                sizeAttribute.setX(i, size);
            }

            for (let s = this.synapses.length - 1; s >= 0; s--) {
                let syn = this.synapses[s];
                syn.life -= 0.05;
                if (syn.life <= 0) {
                    this.synapses.splice(s, 1);
                    continue;
                }
                
                const centerIdx = syn.index;
                const flashColor = { r: 1.0, g: 1.0, b: 1.0 }; 
                
                // Flash cluster
                colorAttribute.setXYZ(centerIdx, flashColor.r, flashColor.g, flashColor.b);
                sizeAttribute.setX(centerIdx, 0.5 * syn.life); 
                
                // Flash neighbors
                for(let k=1; k<=5; k++) {
                    let nIdx = (centerIdx + k) % this.count;
                     colorAttribute.setXYZ(nIdx, flashColor.r, flashColor.g, flashColor.b);
                     sizeAttribute.setX(nIdx, 0.3 * syn.life);
                }
            }

            this.particles.geometry.attributes.position.needsUpdate = true;
            colorAttribute.needsUpdate = true;
            sizeAttribute.needsUpdate = true;

            const dt = 0.016; 
            for (let i = this.thoughtNodes.length - 1; i >= 0; i--) {
                const node = this.thoughtNodes[i];
                node.update(dt);
                if (!node.active) {
                    node.dispose();
                    this.thoughtNodes.splice(i, 1);
                }
            }

            this.renderer.render(this.scene, this.camera);
        }
    }

    if (typeof window !== 'undefined') {
        window.initBrain = () => {
            const container = document.getElementById('brain-container');
            if (container && !window.positronicBrain) {
                window.positronicBrain = new PositronicBrain(container);
            }
        };

        if (document.readyState === 'complete') {
            window.initBrain();
        } else {
            window.addEventListener('load', window.initBrain);
        }
    }
</script>
