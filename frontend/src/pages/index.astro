---
import '../styles/theme.css';
import ChatInterface from '../components/ChatInterface.astro';
import Terminal from '../components/Terminal.astro';
import Experience from '../components/3d/Experience.jsx';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SKYNET // TERMINAL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body class="h-screen w-screen overflow-hidden selection:bg-indigo-500 selection:text-white bg-[#050505] text-slate-200 font-sans relative">
    
    <!-- CENTER: 3D Scene (Background, Z-0) -->
    <div class="absolute inset-0 z-0">
        <Experience client:only="react" />
    </div>

    <main class="absolute inset-0 z-10 flex w-full h-full pointer-events-none">
        
        <!-- LEFT COLUMN: Chat Interface (30%) -->
        <div class="w-[30%] h-full pointer-events-auto flex flex-col p-6 backdrop-blur-3xl bg-black/40 border-r border-white/5 shadow-2xl relative">
            <header class="flex-none mb-6">
                <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-md">
                    <div class="w-2 h-2 rounded-full bg-indigo-500 shadow-[0_0_10px_rgba(99,102,241,0.5)]"></div>
                    <span class="font-mono text-xs text-indigo-200/80 tracking-widest font-bold">SKYNET // CHAT</span>
                </div>
            </header>
            
            <div class="flex-1 min-h-0">
                 <ChatInterface />
            </div>
            
            <div class="mt-4 text-center opacity-50 hover:opacity-100 transition-opacity">
                 <span class="text-[10px] text-slate-600 font-mono">SECURE CHANNEL // <span id="session-id">INIT</span></span>
            </div>
        </div>

        <!-- CENTER COLUMN: Visual Spacer (40%) -->
        <div class="w-[40%] h-full pointer-events-none flex flex-col justify-end pb-10 items-center">
             <!-- Brain is visible through here -->
             <div id="agent-status" class="px-4 py-1.5 rounded-full bg-black/60 border border-white/10 backdrop-blur-md text-[10px] font-mono text-slate-400 mb-8 transition-all">
                 SYSTEM IDLE
             </div>
        </div>

        <!-- RIGHT COLUMN: HUD & Logs (30%) -->
        <div class="w-[30%] h-full pointer-events-auto flex flex-col p-6 backdrop-blur-3xl bg-black/40 border-l border-white/5 shadow-2xl relative">
             <header class="flex-none mb-6 flex justify-between items-center">
                <div class="font-mono text-xs text-emerald-400 font-bold uppercase tracking-wider flex items-center gap-2">
                    <span class="text-emerald-500">⚡</span> SYSTEM LOGS
                </div>
            </header>

            <!-- Rolling Log -->
            <div id="agent-console" class="flex-1 overflow-y-auto space-y-3 font-mono text-[11px] scrollbar-hide pr-2 mask-linear-fade">
                <div class="text-slate-600 italic mt-4">Connecting to neural core...</div>
            </div>

            <!-- Terminal/Tool Output (Bottom of Right Panel) -->
            <div class="mt-6 h-1/3 border-t border-white/10 pt-4 flex flex-col">
                <div class="text-[10px] font-bold text-slate-500 tracking-wider mb-2 uppercase">Terminal Output</div>
                <Terminal />
            </div>
        </div>

    </main>

    <script>
        let currentConversationId = null;
        const ws = new WebSocket(`ws://${window.location.host}/ws`);
        
        const chatBox = document.getElementById('chat-box');
        const messagesPanel = document.getElementById('messages-panel');
        const agentConsole = document.getElementById('agent-console');
        const sessionIdEl = document.getElementById('session-id');
        const agentStatus = document.getElementById('agent-status');

        function appendMessage(role, content) {
            if (!chatBox) return;
            // Clear initial state
            if (chatBox.children.length === 1 && chatBox.children[0].className.includes('text-center')) {
                chatBox.innerHTML = '';
            }

            const msgDiv = document.createElement('div');
            const isUser = role === 'user';
            
            // Simplified chat bubbles for floating UI
            msgDiv.className = `flex gap-3 max-w-[90%] ${isUser ? 'ml-auto flex-row-reverse' : ''} animate-slide-up mb-4`;
            
            const bubbleClass = isUser 
                ? 'bg-indigo-600/90 text-white shadow-glow-indigo rounded-2xl rounded-tr-sm' 
                : 'bg-black/60 border border-slate-700/50 text-slate-200 rounded-2xl rounded-tl-sm backdrop-blur-sm';

             if (typeof marked !== 'undefined' && role !== 'user') {
                content = marked.parse(content);
            }

            msgDiv.innerHTML = `
                <div class="${bubbleClass} px-5 py-3 text-sm leading-relaxed shadow-lg backdrop-blur-sm">
                    ${content}
                </div>
            `;
            
            chatBox.appendChild(msgDiv);
            if(messagesPanel) messagesPanel.scrollTop = messagesPanel.scrollHeight;
        }

        function logAgentThought(content) {
            // Also log to Terminal (Raw)
            logToTerminal(`[THOUGHT] ${content}`, 'text-purple-400/80');
            
            if (!agentConsole) return;
            const div = document.createElement('div');
            div.className = "pl-2 border-l-2 border-indigo-500/30 text-indigo-300/80 animate-fade-in";
            div.innerText = `> ${content}`;
            agentConsole.appendChild(div);
            agentConsole.scrollTop = agentConsole.scrollHeight;
        }

        function logAgentAction(content) {
            // Also log to Terminal (Raw)
            logToTerminal(`[ACTION] ${content}`, 'text-amber-400/80');

            if (!agentConsole) return;
            const isError = content.includes('Error');
            const div = document.createElement('div');
            div.className = `pl-2 border-l-2 ${isError ? 'border-red-500 text-red-400' : 'border-emerald-500 text-emerald-400'} animate-fade-in font-bold`;
            div.innerText = `[${isError ? 'ERR' : 'EXE'}] ${content}`;
            agentConsole.appendChild(div);
            agentConsole.scrollTop = agentConsole.scrollHeight;
        }
        
        function logToTerminal(text, colorClass = 'text-slate-400') {
             const term = document.getElementById('terminal-output');
             if(!term) return;
             
             const line = document.createElement('div');
             line.className = `font-mono whitespace-pre-wrap ${colorClass} text-[9px]`;
             // Add timestamp
             const time = new Date().toISOString().split('T')[1].split('.')[0];
             line.innerText = `[${time}] ${text}`;
             
             term.appendChild(line);
             term.scrollTop = term.scrollHeight;
        }

         ws.onmessage = (event) => {
            const data = JSON.parse(event.data);
            
            if (data.type === 'conversation_created') {
                currentConversationId = data.id;
                sessionIdEl.textContent = `OP-${data.id.toString().padStart(4, '0')}`;
                return;
            }
            
            if (data.role === 'agent-thought') {
                logAgentThought(data.content);
                if (window.positronicBrain) window.positronicBrain.fireSignal(data.content);
                setThinking(true);
            } else if (data.role === 'agent-action') {
                logAgentAction(data.content);
                if (window.positronicBrain) window.positronicBrain.fireSignal(data.content);
                setThinking(true);
            } else if (data.role === 'terminal-output') {
                 // Enhanced Terminal Rendering
                 try {
                     const termData = JSON.parse(data.content);
                     const term = document.getElementById('terminal-output');
                     if(term) {
                         const entry = document.createElement('div');
                         entry.className = "mb-3 pb-1 font-mono text-[10px]";

                         if (termData.type === 'thought') {
                             // Render as comment
                             entry.innerHTML = `<span class="text-slate-500 italic"># ${termData.content}</span>`;
                         } else {
                             // Render as command
                             const cmd = termData.command || "unknown_tool";
                             const out = termData.output || "";
                             
                             // Truncate output if massive
                             const displayOut = out.length > 500 ? out.substring(0, 500) + "... [truncated]" : out;

                             entry.innerHTML = `
                                <div class="flex items-center gap-2 text-emerald-400 font-bold">
                                    <span class="text-blue-500">root@skynet</span><span class="text-slate-500">:</span><span class="text-blue-300">~</span>$ ${cmd}
                                </div>
                                <div class="mt-1 text-slate-300 whitespace-pre-wrap leading-tight pl-4 border-l-2 border-emerald-500/20 py-1">${displayOut}</div>
                             `;
                         }
                         
                         term.appendChild(entry);
                         term.scrollTop = term.scrollHeight;
                     }
                 } catch (e) {
                     console.error("Failed to parse terminal output", e);
                 }
            } else if (data.role === 'system') {
            } else {
                appendMessage(data.role, data.content);
                if (data.role === 'assistant') {
                    if (window.positronicBrain) window.positronicBrain.fireSignal(data.content);
                    setThinking(false);
                    const statusEl = document.getElementById('agent-status');
                    if(statusEl) {
                        statusEl.textContent = 'IDLE';
                        statusEl.className = 'text-[9px] font-mono text-slate-500';
                    }
                }
            }
        };

        function setThinking(isThinking) {
             const statusEl = document.getElementById('agent-status');
             if(!statusEl) return;
             
             if (isThinking) {
                statusEl.textContent = 'PROCESSING...';
                statusEl.className = 'text-[9px] font-mono text-emerald-400 animate-pulse';
            } else {
                statusEl.textContent = 'IDLE';
                statusEl.className = 'text-[9px] font-mono text-slate-500';
            }
        }

        // Chat Form Handling (delegate to ChatInterface logic if possible, or reimplement connection)
        
        // Wait for DOM
        setTimeout(() => {
            const chatForm = document.getElementById('chat-form');
            const promptInput = document.getElementById('prompt-input');
            const sendBtn = document.getElementById('send-btn');
            
            if(chatForm) {
                chatForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const goal = promptInput.value;
                    if (goal) {
                        appendMessage('user', goal);
                        ws.send(JSON.stringify({
                            goal: goal,
                            conversation_id: currentConversationId
                        }));
                        promptInput.value = '';
                        setThinking(true);
                    }
                });
            }
        }, 500); 
        
    </script>
</body>
</html>
